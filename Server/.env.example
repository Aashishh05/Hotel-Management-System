# Server
PORT=8000

# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/hotel-management-system

# Default SuperAdmin created by `npm run seed`
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=change-me-please

# JWT auth. Access tokens are short-lived and kept in an httpOnly "token"
# cookie; refresh tokens live in an httpOnly "refreshToken" cookie.
JWT_SECRET=replace-with-a-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_SECRET=replace-with-another-long-random-string
# (optional) legacy alias still honored for access tokens:
# JWT_EXPIRES_IN=1d

# Cloudinary (room image uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# SMTP (password reset emails). With Gmail, use an app password for EMAIL_USER.
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_SENDER="Grand Horizon Hotel <no-reply@example.com>"

# Public URL of the Client (used to build password-reset links)
CLIENT_URL=http://localhost:5173
